{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app commands, events, updater, restart, folder picker (export).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-open"
  ]
}
