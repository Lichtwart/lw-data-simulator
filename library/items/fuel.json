      "generator": {
        "kind": "randomWalk",
        "center": 65,
        "spread": 15,
        "step": 0.05
      }
    },
    {
      "kind": "modbus",
      "id": "tank_diesel",
      "slave": "tankanlage",
      "registerType": "input",
      "datatype": "uint16",
      "unit": "%",
      "writable": false,
      "title": {
        "de": "Tank Diesel Füllstand",
        "en": "Diesel tank level"
      },
      "tags": [
        "gas-station",
        "category:fuel",
        "zone:forecourt"
      ],
      "control": {
        "kind": "slider",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 60
